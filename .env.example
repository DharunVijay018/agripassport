# ==============================================================================
# AgriPassport Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
#
# IMPORTANT SECURITY RULES:
# - NEVER commit real secrets, private keys, or API keys to git.
# - Variables prefixed with VITE_ are bundled into client-side JS and are public.
# - Variables without VITE_ are server-only and must remain confidential.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3001

# Database Configuration (Local SQLite)
DATABASE_PATH=./data/agripassport.sqlite

# Client URL (Allowed CORS Origin)
FRONTEND_URL=http://localhost:5173

# Frontend Public API URL (Exposed in browser bundles)
VITE_API_BASE_URL=http://localhost:3001/api

# Blockchain Configuration
# Modes: "mock" (default, zero cost, local SHA-256 verification) | "polygon_amoy" (testnet)
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/
BLOCKCHAIN_CHAIN_ID=80002
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=

# AI Freshness Service
# Modes: "heuristic" (local computer vision heuristic based on harvest age & ambient transit)
AI_FRESHNESS_MODE=heuristic
